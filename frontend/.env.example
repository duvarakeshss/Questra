# Frontend env (Vite). Both values are public — the anon key is meant for the browser.

# Backend origin for API calls. When set, requests go straight to `<url>/api`.
# Leave empty to use the Vite dev proxy (`/api` → http://localhost:8000).
VITE_BACKEND_URL=http://localhost:8000

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
